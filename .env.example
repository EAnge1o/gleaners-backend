# 运行环境：dev / test / prod。dev 注册演示控制台并自动种子。
ENV=dev
# 数据库（本地零配置 SQLite）
DB_URL=sqlite:///./gleaners.db
# 支付模式：simulate（默认，零密钥仿真）/ sandbox（真实沙箱）/ agent_pay（审批通过后）
PAY_MODE=simulate
# 服务端密钥（生产务必修改；仅存服务端环境变量，不进仓库）
SECRET_KEY=dev-secret-change-me-to-a-32byte-key!
SIM_SECRET=dev-sim-secret-change-me-32bytes!!
# Fernet 密钥（留空则从 SECRET_KEY 派生，仅演示用）
FERNET_KEY=
# 仿真异步通知延迟（秒，虚拟时钟）
SIM_AUTH_DELAY=2
SIM_PAY_DELAY=2
SIM_REFUND_DELAY=1
# 大模型（默认关闭，走确定性兜底解析器；填写后一键切真实 LLM）
LLM_ENABLED=false
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 启动时若库为空自动种子
SEED_ON_START=true
# 支付宝沙箱凭证（PAY_MODE=sandbox 时才需要）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=